@article{Guerra2024SERSHomogeneity,
  abbr        = {BISTUA},
  title       = {Efficiency and Spatial Homogeneity of the {SERS} Signal in Plasmonic Antennas: A Study at the Nano and Micro Scales},
  author      = {Guerra Hernández, Luis Alfonso and Jaimes Suarez, Oslen Dilayder and Rueda-Parada, Jorge-Enrique},
  journal     = {BISTUA Revista de la Facultad de Ciencias Básicas},
  volume      = {22},
  number      = {2},
  pages       = {1--12},
  year        = {2024},
  doi         = {10.24054/bistua.v22i2.3338},
  preview = {3.png},
  abstract = {This study compares the SERS efficiency and spatial homogeneity of four gold plasmonic substrates: rough surfaces, spherical cavities, the commercial Klarite substrate, and Au-film-on-nanosphere (AuFON) structures, using 4-MBA as a probe molecule. AuFON exhibits by far the highest average SERS intensity, with a value of approximately 236, compared with 3.4 for rough gold, 3.0 for Klarite, and 2.8 for spherical cavities. AuFON also shows the lowest signal dispersion at 17%, followed by Klarite at 21%, spherical cavities at 31%, and rough surfaces at 51%. These results demonstrate that an ordered nanostructure morphology can simultaneously enhance SERS intensity and spatial uniformity, positioning AuFON as a promising platform for ultrasensitive molecular detection.},
  bibtex_show = {true}
}
