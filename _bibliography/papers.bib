@article{Guerra2025AgFON,
  abbr        = {RSI},
  title       = {Green plasmonic mode in {AgFON} structures: A pathway to enhanced {SERS} sensitivity},
  author      = {Guerra Hernández, Luis Alfonso and Tapia Payares, Luis Fernando and Rueda-Parada, Jorge-Enrique and Reynoso, Andrés Alejandro and Rivera Julio, Jagger and Fainstein, Alejandro},
  journal     = {Results in Surfaces and Interfaces},
  volume      = {20},
  pages       = {100587},
  year        = {2025},
  doi         = {10.1016/j.rsurfi.2025.100587},
  preview     = {2.png},
  abstract    = {This work investigates metal-film-on-nanosphere plasmonic structures designed to operate at shorter wavelengths for highly sensitive molecular detection by SERS. A high-energy green plasmonic mode is identified in AgFON structures with sphere diameters of approximately 700--800 nm. Experimental measurements and numerical simulations show that the plasmonic resonances can be tuned through the nanostructure geometry, enabling efficient Raman enhancement and optical sensing in the visible spectral range.},
  bibtex_show = {true}
}

@article{Guerra2024SERSHomogeneity,
  abbr        = {BISTUA},
  title       = {Efficiency and Spatial Homogeneity of the {SERS} Signal in Plasmonic Antennas: A Study at the Nano and Micro Scales},
  author      = {Guerra Hernández, Luis Alfonso and Jaimes Suarez, Oslen Dilayder and Rueda-Parada, Jorge-Enrique},
  journal     = {BISTUA Revista de la Facultad de Ciencias Básicas},
  volume      = {22},
  number      = {2},
  pages       = {1--12},
  year        = {2024},
  doi         = {10.24054/bistua.v22i2.3338},
  preview = {3.png},
  abstract = {This study compares the SERS efficiency and spatial homogeneity of four gold plasmonic substrates: rough surfaces, spherical cavities, the commercial Klarite substrate, and Au-film-on-nanosphere (AuFON) structures, using 4-MBA as a probe molecule. AuFON exhibits by far the highest average SERS intensity, with a value of approximately 236, compared with 3.4 for rough gold, 3.0 for Klarite, and 2.8 for spherical cavities. AuFON also shows the lowest signal dispersion at 17%, followed by Klarite at 21%, spherical cavities at 31%, and rough surfaces at 51%. These results demonstrate that an ordered nanostructure morphology can simultaneously enhance SERS intensity and spatial uniformity, positioning AuFON as a promising platform for ultrasensitive molecular detection.},
  bibtex_show = {true}
}

@article{Guerra2023ChemicalSERS,
  abbr        = {JOSA B},
  title       = {Does the chemical contribution have a secondary role in {SERS}?},
  author      = {Guerra Hernández, Luis Alfonso and Reynoso, Andrés A. and Fainstein, Alejandro},
  journal     = {Journal of the Optical Society of America B},
  volume      = {40},
  number      = {4},
  pages       = {C78--C85},
  year        = {2023},
  doi         = {10.1364/JOSAB.482513},
  preview = {4.png},
  abstract = {This work examines the relative contributions of electromagnetic and chemical enhancement mechanisms in surface-enhanced Raman scattering (SERS). Using 4-mercaptobenzoic acid (4-MBA) as a probe molecule on different plasmonic nanostructures, the study analyzes the role of molecule-metal interactions and charge-transfer processes in the Raman enhancement. The results show that the chemical contribution cannot always be considered merely secondary and that both electromagnetic and chemical mechanisms must be considered when interpreting and optimizing SERS performance.},
  bibtex_show = {true}
}

