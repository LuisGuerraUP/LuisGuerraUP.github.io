@article{Guerra2019FarNear,
  abbr        = {ACS Photonics},
  title       = {Resonant Far- to Near-Field Channeling in Synergetic Multiscale Antennas},
  author      = {Guerra Hernández, Luis Alfonso and Huidobro, Paloma A. and Cortés, Emiliano and Maier, Stefan A. and Fainstein, Alejandro},
  journal     = {ACS Photonics},
  volume      = {6},
  number      = {6},
  pages       = {1466--1473},
  year        = {2019},
  doi         = {10.1021/acsphotonics.9b00120},
  preview     = {7.png},
  abstract = {This work investigates multiscale plasmonic antennas based on metallic sphere-segment void (SSV) cavities with controlled nanoscale roughness. The structures combine wavelength-scale cavity modes with nanoscale surface features to enhance surface-enhanced Raman scattering beyond the response of either mechanism acting independently. By selectively exciting cavity modes with different spatial field distributions, the study shows that modes more strongly confined near the metallic surface provide more efficient channeling of optical energy from the far field into nanoscale near-field hotspots. This cooperative effect becomes stronger as the surface roughness increases. Finite-element simulations of the local electromagnetic fields support the experimental observations and provide a microscopic picture of the far- to near-field energy-transfer mechanism. The results demonstrate a route toward spatially and spectrally optimized multiscale plasmonic antennas for highly efficient optical sensing and SERS.},
  bibtex_show = {true}
}
