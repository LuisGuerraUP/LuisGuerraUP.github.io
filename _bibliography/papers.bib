@article{GuerraHernandez2025AuFON,
  abbr        = {EPJAM},
  title       = {Optimisation and precision tuning of localised surface plasmon resonance in AuFON systems},
  author      = {Guerra Hernández, Luis Alfonso and Gil Salas, Osmar and Rueda Parada, Jorge Enrique and Fainstein, Alejandro and Reynoso, Andrés Alejandro},
  journal     = {EPJ Applied Metamaterials},
  volume      = {12},
  pages       = {4},
  year        = {2025},
  doi         = {10.1051/epjam/2025004},
  preview     = {1.png},
  abstract    = {This work examines the optimisation of Au-film on nanosphere (AuFON) plasmonic structures using experimental measurements and numerical simulations. The study identifies localised surface plasmon resonances and their near-field spatial distributions, analysing how nanostructure dimensions and illumination conditions influence the optical response. The results provide strategies for enhancing optical signals in molecular detection applications.},
  bibtex_show = {true}
}
