@article{Rueda2010Diffraction,
  abbr        = {BISTUA},
  title       = {Eficiencia de difracción de redes fotorrefractivas en {Bi12SiO20}, en términos de tres casos de manipulación del plano de polarización de los haces de registro},
  author      = {Rueda, Jorge Enrique and Guerra Hernández, Luis Alfonso and Castro, Lina Mireya},
  journal     = {BISTUA Revista de la Facultad de Ciencias Básicas},
  volume      = {8},
  number      = {2},
  pages       = {81--86},
  year        = {2010},
 preview     = {11.png},
abstract = {El factor eficiencia de difracción es uno de los parámetros de mérito para las diferentes aplicaciones basadas en la mezcla de ondas en cristales fotorrefractivos, razón por la cual, es importante una caracterización minuciosa del material fotorrefractivo a utilizar en una aplicación particular de mezcla de ondas. En este trabajo, presentamos los resultados experimentales de la influencia de la orientación relativa entre los planos de polarización lineal de los haces de registro, sobre la eficiencia de difracción de la red de volumen registrada en un cristal de Bi12SiO20. El estudió experimental se hizo mediante un arreglo de mezcla de cuatro ondas degenerada, en geometría holográfica de transmisión y configuración transversal del cristal. Trabajamos en régimen de generación de portado res de carga por difusión. Presentamos resultados inéditos.},
  bibtex_show = {true}
}
