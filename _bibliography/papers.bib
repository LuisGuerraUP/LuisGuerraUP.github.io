@article{Guerra2025AgFON,
  abbr        = {RSI},
  title       = {Green plasmonic mode in {AgFON} structures: A pathway to enhanced {SERS} sensitivity},
  author      = {Guerra Hernández, Luis Alfonso and Tapia Payares, Luis Fernando and Rueda-Parada, Jorge-Enrique and Reynoso, Andrés Alejandro and Rivera Julio, Jagger and Fainstein, Alejandro},
  journal     = {Results in Surfaces and Interfaces},
  volume      = {20},
  pages       = {100587},
  year        = {2025},
  doi         = {10.1016/j.rsurfi.2025.100587},
  preview     = {2.png},
  abstract    = {This work investigates metal-film-on-nanosphere plasmonic structures designed to operate at shorter wavelengths for highly sensitive molecular detection by SERS. A high-energy green plasmonic mode is identified in AgFON structures with sphere diameters of approximately 700--800 nm. Experimental measurements and numerical simulations show that the plasmonic resonances can be tuned through the nanostructure geometry, enabling efficient Raman enhancement and optical sensing in the visible spectral range.},
  bibtex_show = {true}
}

@article{Parra2025ElectroFenton,
  abbr         = {Cleaner Waste Systems},
  title        = {Optimization of electro-fenton parameters for phenol degradation in portable toilet wastewater: Advancing towards sustainability},
  author       = {Parra-Orobio, Brayan Alexis and Rico-Lizcano, Yolanda and Soto-Paz, Jonathan and Guerra-Hernández, Luis Alfonso and Manyoma-Velasquez, Pablo César and San Juan-Garisado, Yorgi and Alvarez-Trujillo, Jesús David and Casallas Ojeda, Miguel},
  journal      = {Cleaner Waste Systems},
  volume       = {12},
  pages        = {100328},
  year         = {2025},
  doi          = {10.1016/j.clwas.2025.100328},
  preview      = {A.png},
  abstract     = {This study evaluates the Electro-Fenton process for the treatment of portable toilet wastewater containing high concentrations of phenols and recalcitrant organic matter. Response surface methodology was used to optimize hydrogen peroxide dosage and current density in a 3 L batch reactor. The optimal operating conditions were 187 g L^{-1} of H2O2 and 90 A m^{-2}, achieving 87.6% total suspended solids removal, 96.4% chemical oxygen demand removal, 98% biological oxygen demand removal, and 98% phenol removal. The treated effluent reached a germination index of 108.9%, indicating potential suitability for irrigation. The results demonstrate that Electro-Fenton treatment is an effective strategy for reducing the pollutant load of portable toilet wastewater and supporting water reuse within a sustainability framework.},
  bibtex_show  = {true}
}
